# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/peniel_fellowship
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/peniel_fellowship?retryWrites=true&w=majority
# If password has @ # / etc, URL-encode it (e.g. @ → %40)
MONGODB_URI=mongodb://127.0.0.1:27017/peniel_fellowship

# JWT authentication (create any long secret — do not share)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Frontend origin(s) for CORS — comma-separated OK
# Local: http://localhost:5173
# On Render: optional (RENDER_EXTERNAL_URL is allowed automatically)
CLIENT_URL=http://localhost:5173

# Optional church contact shown in API health
CHURCH_NAME=Peniel Evangelical Fellowship

# Timezone for “today’s program” pastor notifications (India default)
CHURCH_TZ=Asia/Kolkata
# How often to check for day-of notifications (ms). Default 15 minutes.
# DAY_OF_NOTIFY_INTERVAL_MS=900000
