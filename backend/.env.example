# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/peniel_fellowship

# JWT authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Frontend origin(s) for CORS — comma-separated in production
# Example prod: https://penielevangelicalfellowship.org,https://www.penielevangelicalfellowship.org
CLIENT_URL=http://localhost:5173

# Optional church contact shown in API health
CHURCH_NAME=Peniel Evangelical Fellowship
