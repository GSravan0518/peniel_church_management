{
  "name": "peniel-evangelical-fellowship",
  "version": "1.0.0",
  "private": true,
  "description": "Peniel Evangelical Fellowship MERN website",
  "scripts": {
    "setup": "npm run install:all && npm run seed",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "create:staff": "npm run create:staff --prefix backend",
    "db:check": "npm run db:check --prefix backend",
    "start:backend": "npm start --prefix backend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
